@model IEnumerable<SellerProfile>
@{ ViewData["Title"] = "Sellers"; }
<header class="page-header">


<div>

<span class="admin-page-eyebrow">SELLER MANAGEMENT</span>
<h1>
Seller Management
</h1>

<p>
Manage sellers, stores and approvals
</p>


</div>



<div class="admin-profile"><span class="admin-avatar" aria-hidden="true">SM</span><span>Administrator</span></div>


</header>
<section class="controls">
    <input data-workspace-search type="search" aria-label="Search sellers" placeholder="Search sellers...">
    <select data-workspace-filter aria-label="Filter sellers">
        <option value="all">All Sellers</option>
        <option value="approved">Approved</option>
        <option value="pending">Pending</option>
        <option value="rejected">Rejected</option>
    </select>
</section>
<section class="stats">
    <article class="stat-card"><div class="icon"><i class="bi bi-shop"></i></div><div><h2>@(Model.Count())</h2><p>Total sellers</p></div></article>
    <article class="stat-card"><div class="icon"><i class="bi bi-patch-check"></i></div><div><h2>@(Model.Count(item => item.VerificationStatus == "approved"))</h2><p>Approved</p></div></article>
    <article class="stat-card"><div class="icon"><i class="bi bi-clock"></i></div><div><h2>@(Model.Count(item => item.VerificationStatus == "pending"))</h2><p>Pending</p></div></article>
    <article class="stat-card"><div class="icon"><i class="bi bi-slash-circle"></i></div><div><h2>@(Model.Count(item => item.VerificationStatus == "rejected"))</h2><p>Rejected</p></div></article>
</section>
<section class="table-container">
    <div class="table-header"><h2>Sellers list</h2></div>
    <div class="table-wrap"><table><thead><tr><th>Store</th><th>Seller</th><th>Location</th><th>Status</th><th>Verification</th></tr></thead>
<tbody data-workspace-rows>@foreach (var seller in Model)
{
    <tr data-filter="@seller.VerificationStatus"><td><strong>@seller.StoreName</strong></td><td>@seller.User.FullName<br><small>@seller.User.Email</small></td>
    <td>@seller.City @seller.Country</td><td><span class="pill">@seller.VerificationStatus</span></td>
    <td><form class="inline" asp-action="Verify" asp-route-id="@seller.SellerId" method="post">
        <input type="hidden" name="returnToSellers" value="true">
        <button name="approve" value="true">Approve</button><button class="danger" name="approve" value="false">Reject</button>
    </form></td></tr>
}</tbody>
</table></div>
</section>
<script defer src="/admin/components/mvc-table-filter.js"></script>
