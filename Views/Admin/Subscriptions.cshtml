@model IEnumerable<Payment>
@{ ViewData["Title"] = "Subscription payments"; }
<h1>Subscription payments</h1><partial name="_Nav" />
<div class="table-wrap"><table><thead><tr><th>Seller</th><th>Plan</th><th>Amount</th><th>Status</th></tr></thead><tbody>
@foreach (var item in Model)
{
<tr><td>@item.Subscription?.Seller.StoreName</td><td>@item.Subscription?.Plan.PlanName</td>
<td>@item.Amount.ToString("N2") @item.Currency</td>
<td><div class="inline"><span class="pill">@(item.PaymentMethod == "demo" ? "Demo confirmed" : item.PaymentStatus)</span>
@if (item.PaymentStatus == "pending" && item.Subscription?.Status == "scheduled")
{ <form asp-action="ConfirmSubscription" asp-route-id="@item.PaymentId" method="post"><button>Confirm payment received</button></form> }
</div></td></tr>
}
</tbody></table></div>