<section class="moderation-stats" aria-label="Moderation totals">
    <article class="moderation-stat"><span class="stat-icon pending-icon"><i class="bi bi-hourglass-split"></i></span><div><span>Products waiting</span><strong>@ViewBag.PendingProducts</strong></div></article>
    <article class="moderation-stat"><span class="stat-icon approved-icon"><i class="bi bi-check2-circle"></i></span><div><span>Approved products</span><strong>@ViewBag.ApprovedProducts</strong></div></article>
    <article class="moderation-stat"><span class="stat-icon feedback-icon"><i class="bi bi-chat-square-heart"></i></span><div><span>Feedback waiting</span><strong>@ViewBag.PendingFeedback</strong></div></article>
    <article class="moderation-stat"><span class="stat-icon public-icon"><i class="bi bi-chat-left-quote"></i></span><div><span>Public feedback</span><strong>@ViewBag.PublicFeedback</strong></div></article>
</section>
