@model IReadOnlyList<CartItem>
@{
    Layout = null;
    var subtotal = Model.Sum(item => Commerce.Price(item.Listing) * item.Quantity);
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="theme-color" content="#061735">

    <title>Stock Mind | Shopping Cart</title>

    <link rel="stylesheet" href="/cart/cart.css">
    <link rel="stylesheet" href="/css/stock-brand.css">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css">
    <link rel="stylesheet" href="/components/footer.css">
    <link rel="stylesheet" href="/responsive.css?v=site-responsive-2">
</head>

<body>

    <partial name="_StockNavigation" />

    <main class="cart-page">

        <header class="cart-heading">
            <div>
                <span class="eyebrow">YOUR WHOLESALE ORDER</span>
                <h1>Shopping <span>Cart</span></h1>
                <p>Review your products and quantities before checkout.</p>
            </div>

            <a class="continue-link" href="/Market">
                <span>←</span> Continue shopping
            </a>
        </header>

        <div class="cart-layout">

            <section class="cart-panel">

                <div class="panel-heading">
                    <div>
                        <h2>Your items</h2>
                        <p id="productCount">@Model.Count products · @Model.Sum(item => (long)item.Quantity * Commerce.UnitsPerPurchase(item.Listing)) units</p>
                    </div>

                    <span class="wholesale-badge">
                        Wholesale
                    </span>
                </div>

                <div id="cartItems" class="cart-items">
    @foreach (var item in Model)
    {
        var listing = item.Listing;
        <article class="cart-item">
            <div class="cart-item-image"><partial name="_Photo" model="listing.Product" /></div>
            <div class="cart-item-info">
                <h3 class="cart-item-name">@listing.Product.ProductName</h3>
                <p class="cart-item-seller">@listing.Product.Seller.StoreName</p>
                <span class="cart-item-category">@listing.Product.Category.CategoryName</span>
                <p>Minimum order: @Commerce.Minimum(listing) @(listing.SellingMethod == "whole_lot" ? "lot" : "units")</p>
                <span class="wholesale-badge">Platform Commission: @Commerce.FeePercent%</span>
            </div>
            <div class="cart-item-right">
                <p>@(listing.SellingMethod == "whole_lot" ? "Lot price" : "Unit price") <strong>JOD @Commerce.Price(listing).ToString("N2")</strong></p>
                <form class="cart-quantity @(listing.SellingMethod == "whole_lot" ? "is-whole-lot" : "")" asp-action="Set" asp-route-id="@listing.ListingId" method="post">
                    <button class="quantity-button" name="quantity" value="@(item.Quantity - 1)" disabled="@(item.Quantity <= Commerce.Minimum(listing))" aria-label="Decrease quantity">−</button>
                    <span class="quantity-value">@item.Quantity</span>
                    <button class="quantity-button" name="quantity" value="@(item.Quantity + 1)" disabled="@(!Commerce.InStock(listing, item.Quantity + 1))" aria-label="Increase quantity">+</button>
                </form>
                <div class="item-actions">
                    <strong>JOD @((Commerce.Price(listing) * item.Quantity).ToString("N2"))</strong>
                    <form asp-action="Set" asp-route-id="@listing.ListingId" method="post"><button class="remove-button" name="quantity" value="0">Remove</button></form>
                </div>
            </div>
        </article>
    }
</div>

                <section id="emptyCart" class="empty-cart" hidden="@(Model.Count != 0)">
                    <div class="empty-icon">🛍</div>

                    <h2>Your cart is empty</h2>

                    <p>
                        Discover products from our marketplace
                        and build your wholesale order.
                    </p>

                    <a href="/Market" class="primary-button">
                        Explore products <span>→</span>
                    </a>
                </section>

                <p id="cartNotice" class="cart-notice" role="status">@OperationNotice.Text(Context.Request.Query["notice"].ToString())</p>

            </section>

            <aside class="order-summary">

                <div class="summary-heading">
                    <div>
                        <span class="eyebrow">ORDER OVERVIEW</span>
                        <h2>Order summary</h2>
                    </div>

                    <div class="summary-icon">▤</div>
                </div>

                <div class="summary-line">
    <span>Products subtotal</span>
    <strong id="subtotal">JOD @subtotal.ToString("N2")</strong>
</div>


<div class="summary-line commission-line">

    <span>
        Stock Mind Commission (@Commerce.FeePercent%)
    </span>

    <strong id="commission">JOD @Commerce.ServiceFee(subtotal).ToString("N2")</strong>

</div>


<div class="summary-line">
    <span>Shipping</span>
    <strong id="shipping">JOD 0.00</strong>
</div>

                <div class="summary-divider"></div>

                <div class="total-line">
    <span>Estimated total</span>
    <strong id="total">JOD @((subtotal + Commerce.ServiceFee(subtotal)).ToString("N2"))</strong>
</div>

                <p class="summary-note">
                    Shipping costs and final pricing will be
                    confirmed before the order is placed.
                </p>

                @if (Model.Count > 0)
{
    <a id="checkoutButton" class="primary-button checkout-button" asp-action="Checkout">Proceed to checkout <span>→</span></a>
}

                <div class="summary-features">
                    <p><span>✓</span> Wholesale quantities</p>
                    <p><span>✓</span> Review before confirming</p>
                </div>

            </aside>

        </div>

    </main>

    <partial name="_StockFooter" />
</body>
</html>



