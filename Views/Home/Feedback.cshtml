@model FeedbackForm
@{ ViewData["Title"] = "Feedback"; }<h1>Share feedback</h1>
<form class="panel form" asp-action="Feedback" method="post"><div asp-validation-summary="All"></div>
<label>Your name <input asp-for="Name"></label><label>Email <input asp-for="Email"></label>
<label>Rating <select asp-for="Rating">@for (var n = 5; n >= 1; n--) { <option value="@n">@n / 5</option> }</select></label>
<label>Message <textarea asp-for="Message"></textarea></label><button>Submit feedback</button></form>