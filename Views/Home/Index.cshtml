@model LandingViewModel
@{
    Layout = null;
    var sellLink = User.IsInRole("seller") ? "/Seller/Listings" :
        User.Identity?.IsAuthenticated == true ? "/Home/About#how-it-works" : "/Account/Register?seller=true";
    var featured = new[]
    {
        (Names: new[] { "Electronics" }, Image: "/catalog/headphones.jpg", Position: "center"),
        (Names: new[] { "Clothing" }, Image: "/Images/clothes/G74258s.webp", Position: "center 35%"),
        (Names: new[] { "Cosmetics", "Beauty & Personal Care" }, Image: "/catalog/face-cream.png", Position: "center")
    };
}
<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="description" content="Find wholesale products and list surplus inventory on the Stock Mind marketplace.">
    <title>Stock Mind | Wholesale Marketplace</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@@400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/home/style.css">
    <link rel="stylesheet" href="/css/stock-brand.css">
    <link rel="stylesheet" href="/components/footer.css">
    <link rel="stylesheet" href="/responsive.css?v=site-responsive-2">
    <link rel="stylesheet" href="/home/storefront-home.css" asp-append-version="true">
    <link rel="stylesheet" href="/home/stockmind-journey.css" asp-append-version="true">
</head>
<body class="storefront-home">
<partial name="_StockNavigation" />
@if (OperationNotice.Text(Context.Request.Query["notice"].ToString()) is string notice)
{
    <p class="stock-home-notice" role="status">@notice</p>
}
<main id="home">
    <section class="sm-journey" aria-label="From inventory to marketplace">
        <div class="sm-journey__pin">
            <canvas class="sm-journey__canvas" aria-hidden="true"></canvas>
            <div class="sm-journey__inner front-shell">
                <div class="sm-journey__copy">
                    <div class="sm-journey__scene is-active" data-scene="0">
                        <p class="sm-journey__eyebrow">THE WHOLESALE MARKETPLACE</p>
                        <h1>Find stock.<br><em>Move surplus.</em></h1>
                        <p>Buy wholesale in the quantities you need, or list excess inventory for other businesses to discover.</p>
                    </div>
                    <div class="sm-journey__scene" data-scene="1" inert><h2>Every product<br><em>has potential.</em></h2><p>See how inventory moves from the warehouse to the businesses that need it.</p></div>
                    <div class="sm-journey__scene" data-scene="2" inert><h2>Understand<br><em>your stock.</em></h2><p>Use buying estimates and demand forecasts to decide what to stock next.</p></div>
                    <div class="sm-journey__scene" data-scene="3" inert><h2>Know what to keep.<br><em>Know what to sell.</em></h2><p>List your surplus at the price and quantity that work for your business.</p></div>
                    <div class="sm-journey__scene" data-scene="4" inert><h2>Find the right<br><em>wholesale lot.</em></h2><p>Choose the units you need or buy the whole lot.</p></div>
                    <div class="sm-journey__scene" data-scene="5" inert><h2>Smarter inventory.<br><em>Stronger business.</em></h2><p>Explore Stock Mind to find your next purchase or publish a listing.</p></div>
                </div>
                <div class="front-actions sm-journey__actions">
                    <a class="front-button front-button--primary" asp-controller="Market" asp-action="Index">Browse marketplace <span aria-hidden="true">&#8599;</span></a>
                    <a class="front-button" href="@sellLink">@(User.IsInRole("seller") ? "Manage listings" : "Sell your stock") <span aria-hidden="true">&#8594;</span></a>
                </div>
                <a class="sm-journey__skip" href="#categories">Skip to categories <span aria-hidden="true">&#8595;</span></a>
                <div class="sm-journey__progress" aria-hidden="true"><i></i></div>
            </div>
        </div>
    </section>
    <section class="front-categories front-shell" id="categories" aria-labelledby="front-categories-title">
        <header class="front-section-heading">
            <div><p class="front-kicker">MARKETPLACE</p><h2 id="front-categories-title">Shop by category</h2></div>
            <a class="front-link" asp-controller="Market" asp-action="Index">View all categories <span aria-hidden="true">&#8594;</span></a>
        </header>
        <form class="front-search" asp-controller="Market" asp-action="Index" method="get" role="search">
            <label class="front-sr" for="front-query">Search the marketplace</label>
            <i class="fa-solid fa-magnifying-glass" aria-hidden="true"></i>
            <input id="front-query" type="search" name="q" placeholder="Search products or sellers">
            <button type="submit">Search</button>
        </form>
        <div class="front-category-grid">
            @foreach (var feature in featured)
            {
                var category = feature.Names.Select(Model.Category).Where(c => c is not null).MaxBy(c => c!.Listings);
                if (category is null) { continue; }
                <a class="front-category" asp-controller="Market" asp-action="Index" asp-route-category="@category.Id">
                    <img src="@feature.Image" alt="" loading="lazy" style="object-position:@feature.Position">
                    <span class="front-category-name"><strong>@category.Name</strong><span>@category.Listings @(category.Listings == 1 ? "listing" : "listings")</span></span>
                    <span class="front-category-arrow" aria-hidden="true">&#8599;</span>
                </a>
            }
        </div>
    </section>
    <section class="front-operations front-shell" id="about" aria-labelledby="front-operations-title">
        <header class="front-section-heading" id="steps">
            <div><p class="front-kicker">HOW IT WORKS</p><h2 id="front-operations-title">From sourcing to selling</h2></div>
            <a class="front-link" href="/Home/About#our-idea">About Stock Mind <span aria-hidden="true">&#8594;</span></a>
        </header>
        <div class="front-operation-grid">
            <article><i class="fa-solid fa-box-open" aria-hidden="true"></i><h3>Buy wholesale</h3><p>Compare products and choose the quantity or whole lot that fits your business.</p><a class="front-link" asp-controller="Market" asp-action="Index">Find inventory &#8594;</a></article>
            <article><i class="fa-solid fa-store" aria-hidden="true"></i><h3>Sell surplus</h3><p>Publish a listing with your price and available quantity to reach new buyers.</p><a class="front-link" href="@sellLink">@(User.IsInRole("seller") ? "Manage listings" : "Explore selling") &#8594;</a></article>
            <article><i class="fa-solid fa-chart-simple" aria-hidden="true"></i><h3>Plan your next move</h3><p>Use buying estimates and demand forecasts to decide what to stock or sell.</p><a class="front-link" href="@(User.IsInRole("seller") ? "/Seller/Tools" : "/Home/About#how-it-works")">Explore inventory tools &#8594;</a></article>
        </div>
    </section>
    <partial name="_Testimonials" model="Model.Feedback" />
</main>
<partial name="_StockFooter" />
<script type="module" src="/home/stockmind-journey.js" asp-append-version="true"></script>
<script type="module" src="/home/mvc-home.js"></script>
</body>
</html>

