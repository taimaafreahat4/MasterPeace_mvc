@model int
@{ ViewData["Title"] = $"Error {Model}"; }
<section class="panel"><p class="pill">@Model</p><h1>@(Model switch { 403 => "Access restricted", 404 => "Page unavailable", 400 => "Invalid request", _ => "Something went wrong" })</h1>
<a class="button" asp-controller="Home" asp-action="Index">Back to home</a></section>