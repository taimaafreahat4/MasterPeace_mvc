@model IReadOnlyList<VwHomeFeedback>
<section class="testimonials" id="testimonials">
    <div class="container">
        <div class="center-heading">
            <div class="section-label">WHAT OUR USERS SAY</div>
            <h2 class="section-title">What merchants <span>say</span></h2>
            <p class="section-subtitle">Demo testimonials and approved feedback from Stock Mind merchants and customers.</p>
        </div>
        @if (Model.Count == 0)
        {
            <p class="section-subtitle center-heading">No approved feedback yet.</p>
        }
        else
        {
            <div class="t-stage" id="tStage">
                <div class="t-arc" aria-hidden="true"><span></span><span></span><span></span></div>
                <div class="t-track" id="tTrack">
                    @foreach (var item in Model)
                    {
                        var displayName = string.IsNullOrWhiteSpace(item.DisplayName) ? "Stock Mind member" : item.DisplayName;
                        var initials = string.Concat(displayName.Split(' ', StringSplitOptions.RemoveEmptyEntries).Take(2).Select(part => char.ToUpperInvariant(part[0])));
                        var (role, tag) = item.Category switch
                        {
                            "demo-electronics" => ("Electronics Retailer", "Fewer losses"),
                            "demo-retail" => ("Retail Store Owner", "Smarter buying"),
                            "demo-online" => ("Online Store Owner", "Smarter buying"),
                            "demo-business" => ("Small Business Owner", "Faster selling"),
                            "demo-wholesale" => ("Wholesale Merchant", "Better decisions"),
                            _ => ("Stock Mind member", "Merchant feedback")
                        };
                        <article class="t-card" data-feedback-id="@item.FeedbackId">
                            <div class="t-quote" aria-hidden="true">“</div>
                            <div class="t-user">
                                <div class="t-avatar t-avatar-initials" aria-hidden="true">@initials</div>
                                <div><h3 class="t-name">@displayName</h3><span class="t-role">@role</span></div>
                            </div>
                            <p class="t-text">“@item.Message”</p>
                            <div class="t-foot">
                                @if (item.Rating is byte value && value is >= 1 and <= 5)
                                {
                                    <div class="t-stars" aria-label="@value out of 5 stars">@(new string('★', value) + new string('☆', 5 - value))</div>
                                }
                                else { <span class="t-verified-label">Approved feedback</span> }
                                <span class="t-chip">@tag</span>
                            </div>
                        </article>
                    }
                </div>
                <button type="button" class="t-arrow t-prev" id="tPrev" aria-label="Previous"><i class="fa-solid fa-chevron-left"></i></button>
                <button type="button" class="t-arrow t-next" id="tNext" aria-label="Next"><i class="fa-solid fa-chevron-right"></i></button>
            </div>
            <div class="t-dots" id="tDots"></div>
        }
    </div>
</section>


