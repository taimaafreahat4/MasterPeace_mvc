@model IEnumerable<Order>
@{ if (User.IsInRole("admin")) Layout = "_AdminWorkspace"; ViewData["Title"] = "Orders"; }
<h1>@(User.IsInRole("admin") ? "Orders" : "Your orders")</h1>
@if (!Model.Any()) { <p class="panel empty">No orders yet.</p> }
else
{
<div class="table-wrap"><table><thead><tr><th>Order</th><th>Date (UTC)</th><th>Status</th><th>Total</th></tr></thead><tbody>
@foreach (var row in Model)
{
<tr><td><a asp-action="Details" asp-route-id="@row.OrderId">@row.OrderNumber</a></td><td>@row.CreatedAt.ToString("yyyy-MM-dd")</td><td><span class="pill">@row.OrderStatus</span></td><td>@row.GrandTotal.ToString("N2") JOD</td></tr>
}
</tbody></table></div>
}
