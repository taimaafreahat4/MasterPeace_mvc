@model StoreProfileForm
@{ Layout = null; }
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="theme-color" content="#061735">
  <title>Store Profile | Stock Mind</title>
  <link rel="stylesheet" href="/seller/stockmind_seller_center/seller-shared.css">
  <link rel="stylesheet" href="/seller/stockmind_seller_center/seller-tabs.css">
  <link rel="stylesheet" href="/seller/stockmind_seller_center/store-profile.css?v=store-category-filter-1">
  <link rel="stylesheet" href="/css/stock-brand.css">
    <link rel="stylesheet" href="/responsive.css?v=site-responsive-2">
</head>
<body data-seller-page="store-profile">
  <partial name="_StockNavigation" />
  <div id="seller-tabs-mount"><partial name="_SellerTabs" /></div>
  <main class="sm-page store-page">
    <section class="store-intro">
      <div>
        <span class="sm-eyebrow">SELLER CENTER / STORE PROFILE</span>
        <h1>Set up your store</h1>
        <p>This page is for your business only: its name, location, customers, and what it offers. Your personal name and contact details remain separate under Edit Profile.</p>
      </div>
      <div class="store-mark" aria-hidden="true">▦</div>
    </section>
    <section class="sm-card store-card" aria-labelledby="storeFormTitle">
      <div class="store-card-heading">
        <div><span class="sm-pill">YOUR BUSINESS PROFILE</span><h2 id="storeFormTitle">Store information</h2><p>Required fields are marked with an asterisk.</p></div>
      </div>
      <div asp-validation-summary="All" id="storeMessage" class="store-message" role="status" aria-live="polite"></div>
      <form id="storeProfileForm" asp-action="StoreProfile" method="post">
        <div class="store-form-grid">
          <label class="store-field"><span>Store name <i>*</i></span><input id="storeName" asp-for="StoreName" type="text" placeholder="e.g. Ahmad Fashion" required minlength="2" maxlength="80" autocomplete="organization"><small>Use the name customers and partners recognize.</small></label>
          <label class="store-field"><span>What does your store sell? <i>*</i></span><select id="businessCategory" asp-for="BusinessCategory" required><option value="">Select your business category</option><option value="electronics">Phones &amp; Electronics</option><option value="home">Home &amp; Living</option><option value="clothes">Clothes &amp; Fashion</option><option value="books">Books &amp; Stationery</option><option value="toys_baby">Toys &amp; Baby</option><option value="cosmetics">Cosmetics &amp; Beauty</option><option value="accessories">Bags &amp; Accessories</option><option value="sports">Sports</option><option value="grocery">Grocery</option><option value="other">Other</option></select><small>This determines which other sellers’ listings appear in your Marketplace.</small></label>
          <label class="store-field"><span>Precise location (street, neighborhood, or landmark) <i>*</i></span><input id="locationDetails" asp-for="LocationDetails" type="text" placeholder="e.g. University Street, near the north gate" required minlength="4" maxlength="180" autocomplete="street-address"><small>Be specific so the analysis uses your actual market area.</small></label>
          <label class="store-field"><span>City <i>*</i></span><input id="city" asp-for="City" type="text" placeholder="e.g. Amman" required minlength="2" maxlength="80" autocomplete="address-level2"></label>
          <label class="store-field"><span>Country <i>*</i></span><input id="country" asp-for="Country" type="text" placeholder="e.g. Jordan" required minlength="2" maxlength="80" autocomplete="country-name"></label>
          <label class="store-field"><span>Store area type <i>*</i></span><select id="storeType" asp-for="StoreType" required><option value="">Select an area type</option><option value="residential">Residential area</option><option value="commercial">Commercial shopping area</option><option value="mall">Mall</option><option value="online">Online store</option><option value="other">Other</option></select><small>This describes the area, not the products you sell.</small></label>
          <label class="store-field"><span>Target customers <i>*</i></span><select id="targetCustomers" asp-for="TargetCustomers" required><option value="">Select your main customers</option><option value="youngAdults">Young adults</option><option value="families">Families and mixed ages</option><option value="students">University students</option><option value="professionals">Professionals</option><option value="general">General customers</option><option value="other">Other</option></select></label>
          <label class="store-field"><span>Average visitors per day <i>*</i></span><input id="averageVisitorsPerDay" asp-for="AverageVisitorsPerDay" type="number" min="0" max="1000000" step="1" inputmode="numeric" placeholder="e.g. 50" required><small>Enter an estimate, including 0 if you have no walk-in visitors.</small></label>
          <label class="store-field store-field--full"><span>Store description <small>(Optional)</small></span><textarea id="description" asp-for="Description" rows="4" maxlength="500" placeholder="Tell us what you sell and what makes your store unique."></textarea><small>Up to 500 characters</small></label>
        </div>
        <div class="store-form-footer"><p>Your store profile is saved in your Stock Mind account.</p><button id="saveStoreButton" class="sm-btn sm-btn-primary" type="submit"><span>Save &amp; Continue</span><span aria-hidden="true">→</span></button></div>
      </form>
    </section>
  </main>
</body>
</html>
