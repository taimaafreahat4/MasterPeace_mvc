@{ Layout = null; }
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="theme-color" content="#061735">
  <title>AI Tools | Stock Mind</title>
  <link rel="stylesheet" href="/seller/stockmind_seller_center/seller-shared.css">
  <link rel="stylesheet" href="/seller/stockmind_seller_center/seller-tabs.css">
  <link rel="stylesheet" href="/seller/stockmind_seller_center/ai-tools.css">
  <link rel="stylesheet" href="subscription-access.css?v=freemium-2">
  <link rel="stylesheet" href="/css/stock-brand.css">
  <link rel="stylesheet" href="/components/footer.css">
  <link rel="stylesheet" href="/responsive.css?v=site-responsive-2">
</head>
<body data-seller-page="ai-tools">
  <partial name="_StockNavigation" />
  <div id="seller-tabs-mount"><partial name="_SellerTabs" /></div>
  <main class="sm-page ai-tools-page">
    <header class="ai-tools-hero">
      <span class="ai-tools-eyebrow"><span></span> STOCK MIND INTELLIGENCE</span>
      <h1>Choose the right tool<br><em>for your next decision.</em></h1>
      <p>Analyze a product before you buy it, or get a practical next step for surplus you already have.</p>
      <div class="ai-tools-plan" id="ai-tools-plan" role="status" aria-live="polite">Review purchase costs and current stock data.</div>
    </header>

    <section class="ai-tools-grid" aria-label="Stock Mind AI tools">
      <article class="ai-tool-card ai-tool-card--buy">
        <div class="ai-tool-card__top"><span class="ai-tool-icon" aria-hidden="true">◈</span><span class="ai-tool-label">BUY WITH CONFIDENCE</span></div>
        <h2>Before You Buy</h2>
        <p>Enter a product, its cost, expected selling price, quantity, and store context to review the purchase before committing your budget.</p>
        <div class="ai-tool-meta"><span>Available tools</span><strong id="buy-allowance">Stock analysis</strong></div>
        <a class="ai-tool-button" href="/Purchase">Open Before You Buy <span aria-hidden="true">→</span></a>
      </article>

      <article class="ai-tool-card ai-tool-card--recommend">
        <div class="ai-tool-card__top"><span class="ai-tool-icon" aria-hidden="true">✧</span><span class="ai-tool-label">SELL SURPLUS SMARTER</span></div>
        <h2>AI Recommendations</h2>
        <p>Add a surplus product with its photo and total quantity. Review pricing, demand signals, and suggested actions for that specific lot.</p>
        <div class="ai-tool-meta"><span>Available tools</span><strong id="rec-allowance">Stock analysis</strong></div>
        <a class="ai-tool-button" href="/Seller/Insights">Open AI Recommendations <span aria-hidden="true">→</span></a>
      </article>
    </section>

    <section class="ai-tools-premium">
      <div><span class="ai-tools-eyebrow">WHEN YOUR STORE IS READY</span><h2>Keep analyzing with Premium</h2><p>View available plans and your subscription history.</p></div>
      <a href="/Seller/Plans">Compare Premium plans <span aria-hidden="true">→</span></a>
    </section>
    <p class="ai-tools-footnote">Recommendations use your current inventory and delivered sales.</p>
  </main>
  <partial name="_StockFooter" />
</body>
</html>
